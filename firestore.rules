rules_version = '2';
// MONEY — every read and write goes through trusted server code (Firebase Admin SDK, which bypasses rules).
// Browsers get NO direct Firestore access. This is deliberate: payment state is owned by the backend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
