# ── MONEY Phase 1 — copy to .env.local (PowerShell: Copy-Item .env.example .env.local) ──
# NEVER commit .env.local. Nothing in this file is a real secret.

# Public base URL of this app (used to build hosted-checkout links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase web app config (Firebase console → Project settings → Your apps → Web) — safe to expose to browsers ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only; Project settings → Service accounts → Generate new private key) ──
# Copy the three values from the downloaded JSON. Keep the quotes and the literal \n sequences in the key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── MONEY server secrets (generate each yourself; see README) ──
# 32 random bytes, base64.   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }) -as [byte[]])
MONEY_ENCRYPTION_KEY=
# Any long random string used as an HMAC pepper for API-key hashes. Changing it invalidates existing keys.
MONEY_KEY_PEPPER=

# ── Optional: Firebase Emulator Suite (needs firebase-tools + Java). Set all four to use it instead of a cloud project. ──
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# (with the emulator you may set FIREBASE_PROJECT_ID to any id such as demo-money and leave the Admin key blank)
